# Multi-Brand Email Automation - Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# GOOGLE APIS
# ============================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# Google Sheets IDs
GOOGLE_SPREADSHEET_ID=your_main_spreadsheet_id
GOOGLE_CONTACTS_SHEET_NAME="Ultimate Contact Sheet"
GOOGLE_HISTORY_SHEET_NAME="Send History Log"
GOOGLE_BRANDS_SHEET_NAME="Brand Configuration"
GOOGLE_TEMPLATES_SHEET_NAME="Template Library"
GOOGLE_QUEUE_SHEET_NAME="Campaign Queue"

# ============================================
# AIRTABLE
# ============================================
AIRTABLE_API_KEY=your_airtable_api_key_here
AIRTABLE_BASE_ID=your_airtable_base_id
AIRTABLE_CONTACTS_TABLE=Contacts
AIRTABLE_CAMPAIGNS_TABLE=Campaigns
AIRTABLE_QUEUE_TABLE="Campaign Queue"
AIRTABLE_BRANDS_TABLE=Brands
AIRTABLE_TEMPLATES_TABLE=Templates

# ============================================
# ANTHROPIC CLAUDE API
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_MAX_TOKENS=1000
CLAUDE_TEMPERATURE=0.7

# ============================================
# N8N CONFIGURATION
# ============================================
N8N_HOST=https://your-n8n-instance.com
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.com/webhook

# Webhook URLs (automatically generated by n8n)
N8N_WEBHOOK_CAMPAIGN_INIT=/campaign-init
N8N_WEBHOOK_TRACK_OPENS=/track-opens
N8N_WEBHOOK_TRACK_CLICKS=/track-clicks
N8N_WEBHOOK_SEND_CONFIRMATION=/send-confirmation

# ============================================
# LIDO
# ============================================
LIDO_SPREADSHEET_ID=your_lido_spreadsheet_id
LIDO_API_KEY=your_lido_api_key_here
LIDO_SEND_QUEUE_SHEET_NAME="Send Queue"

# ============================================
# EMAIL TRACKING
# ============================================
TRACKING_DOMAIN=track.yourdomain.com
TRACKING_PIXEL_URL=https://track.yourdomain.com/pixel
TRACKING_LINK_URL=https://track.yourdomain.com/click

# ============================================
# REDIS (OPTIONAL - FOR CACHING)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# MONITORING & LOGGING
# ============================================
SENTRY_DSN=your_sentry_dsn_here
LOG_LEVEL=info
LOG_FORMAT=json

# Prometheus metrics (if using)
PROMETHEUS_PORT=9090
PROMETHEUS_ENABLED=false

# ============================================
# RATE LIMITS
# ============================================
# Gmail API Rate Limits
GMAIL_RATE_LIMIT_PER_SECOND=25
GMAIL_RATE_LIMIT_PER_DAY=1000000

# Google Sheets API Rate Limits
SHEETS_RATE_LIMIT_PER_MINUTE=60
SHEETS_RATE_LIMIT_PER_USER_PER_MINUTE=60

# Airtable API Rate Limits
AIRTABLE_RATE_LIMIT_PER_SECOND=5
AIRTABLE_RATE_LIMIT_PER_BASE_PER_SECOND=5

# Claude API Rate Limits
CLAUDE_RATE_LIMIT_PER_MINUTE=50
CLAUDE_RATE_LIMIT_PER_DAY=10000

# ============================================
# FREQUENCY CONTROL SETTINGS
# ============================================
# Hard limits (block send)
FREQUENCY_HARD_LIMIT_24H=1
FREQUENCY_HARD_LIMIT_7D=3
FREQUENCY_HARD_LIMIT_30D=10

# Warning thresholds
FREQUENCY_WARNING_24H=1
FREQUENCY_WARNING_7D=2
FREQUENCY_WARNING_30D=8

# Engagement-based adjustments
FREQUENCY_HIGH_ENGAGEMENT_THRESHOLD=80
FREQUENCY_LOW_ENGAGEMENT_THRESHOLD=20
FREQUENCY_NO_ENGAGEMENT_PAUSE_DAYS=30

# ============================================
# CAMPAIGN SETTINGS
# ============================================
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_BATCH_DELAY_SECONDS=60
CAMPAIGN_MAX_RETRIES=3
CAMPAIGN_RETRY_DELAY_SECONDS=300

# ============================================
# AUTO-PILOT MODE
# ============================================
AUTOPILOT_ENABLED=true
AUTOPILOT_SCHEDULE_TIME=09:00
AUTOPILOT_TIMEZONE=America/New_York
AUTOPILOT_MIN_LEAD_SCORE=7
AUTOPILOT_MIN_DAYS_SINCE_CONTACT=7
AUTOPILOT_MAX_DAYS_SINCE_CONTACT=30

# ============================================
# UI CONFIGURATION
# ============================================
UI_PORT=3000
UI_BASE_URL=http://localhost:3000
UI_SESSION_SECRET=your_session_secret_here
UI_JWT_SECRET=your_jwt_secret_here

# ============================================
# SECURITY
# ============================================
ENCRYPTION_KEY=your_32_character_encryption_key
ENCRYPTION_ALGORITHM=aes-256-cbc
SESSION_TIMEOUT_MINUTES=60

# CORS Settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AUTO_PILOT=true
FEATURE_AI_GENERATION=true
FEATURE_CLICK_TRACKING=true
FEATURE_ENGAGEMENT_SCORING=true
FEATURE_TEMPLATE_AB_TESTING=false

# ============================================
# DEVELOPMENT/STAGING
# ============================================
NODE_ENV=production
DEBUG=false
TEST_MODE=false

# If TEST_MODE=true, emails won't actually send
TEST_MODE_EMAIL_RECIPIENT=test@yourdomain.com
